# Flashy Signaling Server — Environment Configuration
# Copy this file to .env and fill in the values.

# Server
PORT=8080
HOST=0.0.0.0

# Database (SQLite — file path relative to server root)
DB_PATH=./data/flashy.db

# Email service (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@flashy.app

# TURN server credentials (for WebRTC fallback relay)
TURN_SERVER_URL=turn:your-server.example.com:3478
TURN_USERNAME=flashy
TURN_PASSWORD=change_this_in_production

# Security
SESSION_TOKEN_EXPIRY_DAYS=30
PAIRING_TOKEN_EXPIRY_SECONDS=120
EMAIL_CODE_EXPIRY_SECONDS=600
EMAIL_CODE_RATE_LIMIT_MAX=5
EMAIL_CODE_RATE_LIMIT_WINDOW_SECONDS=900
